PORT=3000

# --- Application (JWT) Authentication ---
# Secret used to sign/verify JWTs issued by POST /api/v1/auth/login.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
# Single demo account used by the login endpoint (no user database in this project).
AUTH_USERNAME=admin
# bcrypt hash of your chosen password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
AUTH_PASSWORD_HASH=replace_with_a_bcrypt_hash

# --- Gallagher API Configuration ---
GALLAGHER_API_URL=https://your-gallagher-server:8904
GALLAGHER_API_KEY=your_gallagher_api_key
DEFAULT_ACCESS_GROUP_ID=your_default_access_group_id

# --- Environment Mode ---
NODE_ENV=development

# --- TLS / Client certificate (required by Gallagher's REST API) ---
# Set to 'true' in production once you have a valid CA-signed setup.
SSL_REJECT_UNAUTHORIZED=false
CLIENT_CERT_PATH=../certificates/GallagherRestClientCert.pfx
CERT_PASSPHRASE=your_certificate_passphrase

# --- Timeouts ---
REQUEST_TIMEOUT=30000

# --- Logging ---
LOG_LEVEL=info
FILE_LOG_LEVEL=info
CONSOLE_LOG_LEVEL=debug
# Set to 'true' only in trusted local/dev environments to see unredacted names/emails in logs.
LOG_SHOW_PII=false

# --- Debug mode ---
DEBUG=true
