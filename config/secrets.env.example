PORT=3000

# --- Application (JWT) Authentication ---
# Secret used to sign/verify JWTs issued by POST /api/v1/auth/login.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
# Single demo account used by the login endpoint (no user database in this project).
AUTH_USERNAME=admin
# bcrypt hash of your chosen password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
AUTH_PASSWORD_HASH=replace_with_a_bcrypt_hash

# --- Gallagher API Configuration ---
# If Gallagher Command Centre runs on this same machine, use its LAN IP (from
# `ipconfig`), not 127.0.0.1/localhost — Command Centre's REST Client IP allowlist
# matches on the interface address, and loopback connections get a bare 401.
GALLAGHER_API_URL=https://your-gallagher-server:8904
GALLAGHER_API_KEY=your_gallagher_api_key
DEFAULT_ACCESS_GROUP_ID=your_default_access_group_id
# Must exactly match an existing division name (Configure > Divisions).
DEFAULT_DIVISION_NAME=your_default_division_name
# Card type IDs from Configure > Card Types in your instance (these vary per install -
# fetch GET {GALLAGHER_API_URL}/api/card_types with your API key to find yours).
GALLAGHER_ACCESS_CARD_TYPE_ID=your_access_card_type_id
GALLAGHER_MSIC_CARD_TYPE_ID=your_msic_card_type_id

# --- Environment Mode ---
NODE_ENV=development

# --- TLS / Client certificate ---
# Only needed if Gallagher CC does NOT have "Enable REST Clients with no client
# certificate" checked. If it does, omit CLIENT_CERT_PATH/CERT_PASSPHRASE entirely.
SSL_REJECT_UNAUTHORIZED=false
CLIENT_CERT_PATH=../certificates/GallagherRestClientCert.pfx
CERT_PASSPHRASE=your_certificate_passphrase

# --- Timeouts ---
REQUEST_TIMEOUT=30000

# --- Logging ---
LOG_LEVEL=info
FILE_LOG_LEVEL=info
CONSOLE_LOG_LEVEL=debug
# Set to 'true' only in trusted local/dev environments to see unredacted names/emails in logs.
LOG_SHOW_PII=false

# --- Debug mode ---
DEBUG=true
